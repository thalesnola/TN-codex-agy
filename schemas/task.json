{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Argon task",
  "type": "object",
  "additionalProperties": false,
  "required": ["objective", "role", "source"],
  "properties": {
    "objective": {"type": "string", "minLength": 1, "maxLength": 16000},
    "role": {"enum": ["ask", "explore", "research", "challenge", "implement", "document", "review"]},
    "source": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "owns": {"type": "array", "items": {"type": "string"}},
    "acceptance": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "review_of": {"type": "string"},
    "model": {"enum": ["gemini-4-argon-high", "gemini-4-argon-medium", "gemini-4-argon-low", "gemini-3.8-flash-high", "gemini-3.8-flash-medium", "gemini-3.8-flash-low"]},
    "timeout": {"type": "integer", "minimum": 1, "maximum": 3600},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 6},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 200}
  }
}
